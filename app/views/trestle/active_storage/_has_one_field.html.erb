<div class="active-storage">
  <% if attachment.attached? && builder.object.persisted? %>
    <div class="active-storage__preview">
      <% if attachment.previewable? || attachment.variable? %>
        <%= link_to main_app.rails_blob_path(attachment), target: "_blank" do %>
          <%= image_tag main_app.url_for(attachment.variant(resize_to_limit: [300, 300])), class: "active-storage__image", width: 300, height: 300 %>
        <% end %>
      <% else %>
        <%= link_to main_app.rails_blob_path(attachment, disposition: "attachment"), class: "btn btn-info" do %>
          <i class="fa fa-download"></i>
          <span class="btn-label"><%= t('trestle.attachments.download') %></span>
        <% end %>
      <% end %>
      <div><small><%= attachment.blob.filename %></small></div>
    </div>

    <%= builder.check_box("delete_#{field_name}", label: t('trestle.attachments.delete')) %>
  <% end %>

  <div class="progress" style="display: none">
    <div class="progress-bar progress-bar-striped active"></div>
  </div>

  <%= builder.raw_file_field(field_name, class: 'active-storage__field', direct_upload: true) %>
</div>
