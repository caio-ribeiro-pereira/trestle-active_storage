<div class='nested-fields-container'>
  <%= builder.fields_for field_name do %>
    <div class="active-storage">
      <% if attachments.attached? && builder.object.persisted?  %>
        <% attachments.each do |attachment| %>
          <div class="active-storage__preview">
            <% if attachment.previewable? || attachment.variable? %>
              <%= link_to main_app.rails_blob_path(attachment), target: "_blank", rel: "noopener noreferrer" do %>
                <%= image_tag main_app.rails_blob_path(attachment), class: "active-storage__image" %>
              <% end %>
            <% else %>
              <%= link_to main_app.rails_blob_path(attachment, disposition: "attachment"), class: "btn btn-info" do %>
                <i class="fa fa-download"></i>
                <span class="btn-label"><%= t('trestle.attachments.download') %></span>
              <% end %>
            <% end %>
            <% if attachment.persisted? %>
              <div>
                <small><%= attachment.blob.filename %></small>
                <%= builder.check_box("delete_#{field_name}_#{attachment.blob_id.to_s.gsub('-', '')}", label: t('trestle.attachments.delete')) %>
              </div>
            <% else %>
              <small><%= attachment.blob.filename %></small>
            <% end %>
          </div>
          <hr>
        <% end %>
      <% end %>
    </div>

    <%= builder.raw_file_field(field_name, class: 'active-storage__field', multiple: true, direct_upload: true) %>
  <% end %>
</div>
